PORT=5000

MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=rams_platform

JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

JWT_EXPIRES_IN=1d

FRONTEND_URL=http://localhost:3000
# Optional path prefix when the frontend is served under a base path (for example /rams-lab).
FRONTEND_BASE_PATH=

# Reverse proxy topology. Use false when the API is directly exposed, a
# positive hop count when a known number of proxies sits in front, or a
# trusted proxy list such as loopback or 10.0.0.0/8. Never use true.
TRUST_PROXY=false
PUBLIC_API_URL=http://localhost:5000
CLOUDINARY_URL=cloudinary://replace:replace@your-cloud-name
NODE_ENV=development

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-unique-12-character-password
SEED_DOSEN_EMAIL=dosen@example.com
SEED_DOSEN_PASSWORD=replace-with-a-unique-12-character-password


# Mailjet Send API v3.1 requires an API key and secret pair. The sender email
# must be a validated sender address in the Mailjet account or an authenticated
# domain. Rotate any shared or previously exposed credentials before use.
MAILJET_API_KEY=replace-with-mailjet-api-key
MAILJET_SECRET_KEY=replace-with-mailjet-secret-key
MAILJET_SENDER_EMAIL=marketing@rams.co.id
MAILJET_SENDER_NAME="RAMS Research Lab"
# Log recipients and subject without calling the Mailjet API. Tests always dry-run.
MAILJET_DRY_RUN=false

CRON_SECRET=replace-with-a-random-cron-secret

# Meeting reminders run from POST /api/cron/meeting-reminders, authenticated
# with CRON_SECRET. The channel is email or whatsapp; email uses Mailjet.
# Intervals are fixed at 24 hours and 1 hour before startAt.
MEETING_REMINDER_CHANNEL=email

MEETING_REMINDER_CONTRACT_LEGACY_INDEXES=false
MEETING_REMINDER_POLL_MS=60000
MEETING_REMINDER_TIMEZONE=Asia/Jakarta
MEETING_REMINDER_MAX_ATTEMPTS=4
MEETING_REMINDER_LEASE_MS=120000
MEETING_REMINDER_RETRY_BASE_MS=60000
MEETING_REMINDER_RETRY_CAP_MS=900000
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
PASSWORD_RESET_MIN_RESPONSE_MS=250

# Server-only Meeting Highlight configuration. Comma-separated user IDs.
MEETINGS_HIGHLIGHTED_USER_IDS=
